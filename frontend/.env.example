# API URL for frontend requests
VITE_API_URL=http://localhost:8000/api

# Optional (dev only): enable debug logs for Google popup auth listener
# VITE_GOOGLE_AUTH_DEBUG=true

# Optional (dev only): bypass origin checks for postMessage (NOT recommended)
# VITE_GOOGLE_AUTH_ALLOW_ANY_ORIGIN_IN_DEV=true

# Google OAuth 2.0 Client ID (optional, for Google Sign-In)
# Get yours from: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=
